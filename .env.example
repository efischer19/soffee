# Slack Socket Mode Authentication
# These tokens are required for Sofie to connect to your Slack workspace via Socket Mode.
#
# To obtain these tokens:
# 1. Create or select an app at https://api.slack.com/apps
# 2. Under "Socket Mode" section, enable Socket Mode to generate an App Token
# 3. Under "OAuth & Permissions" section, generate a Bot Token
#
# For detailed instructions, see: https://slack.dev/python-slack-sdk/socket-mode/
SLACK_APP_TOKEN=xapp-1-XXXXXXXXXXXXXXX
SLACK_BOT_TOKEN=xoxb-XXXXXXXXXXXXXXX

# ESPN Fantasy Football League Configuration
# These credentials are required to access a private ESPN fantasy football league.
#
# To obtain these values:
# 1. SWID: Your ESPN account ID, found in browser cookies (s_vi or SWID)
# 2. S2: Your ESPN session token, found in browser cookies (espn_s2)
# 3. LEAGUE_ID: Your ESPN fantasy league ID (visible in league URL)
# 4. YEAR: The season year for the league (e.g., 2024, 2025)
#
# For detailed instructions, see: https://github.com/reclaimthesports/espn-api
ESPN_SWID=XXXXXXXXXXXXXXX
ESPN_S2=XXXXXXXXXXXXXXX
ESPN_LEAGUE_ID=XXXXXXXXXXXXXXX
ESPN_YEAR=2025

# Slack User ID -> ESPN Team ID authorization mapping.
# JSON object format: {"U1234567890": 1, "U0987654321": 2}
SOFFEE_SLACK_USER_TO_TEAM_MAP={"U1234567890": 1}

# OpenClaw Automated Broadcast Configuration
# These settings control cron schedules for automated NFL window broadcasts via Slack.
#
# SOFFEE_BROADCAST_CHANNEL: Slack channel for automated broadcasts
#   Format: Channel name (e.g., #nfl-updates) or channel ID (e.g., C1234567890)
#   Default: #nfl-updates
SOFFEE_BROADCAST_CHANNEL=#nfl-updates

# Cron schedule patterns for automated broadcasts (all times in UTC, accounting for EST offset)
# Standard cron format: minute hour day month day-of-week
#
# Sunday 10 AM EST (15:00 UTC) — roster violation sweep
SOFFEE_CRON_SUNDAY_10AM=0 15 * * 0

# Sunday 12 PM EST (17:00 UTC)
SOFFEE_CRON_SUNDAY_12PM=0 17 * * 0

# Sunday 4:30 PM EST (21:30 UTC)
SOFFEE_CRON_SUNDAY_430PM=30 21 * * 0

# Sunday 8 PM EST (1:00 AM Monday UTC)
SOFFEE_CRON_SUNDAY_8PM=0 1 * * 1

# Monday/Tuesday 7 AM EST (12:00 PM UTC)
SOFFEE_CRON_MONDAY_TUESDAY_7AM=0 12 * * 1,2
