# ESPN league access. There's no official ESPN API: Sofie uses the commissioner's
# browser cookies, which grant access to the whole ESPN account. Never commit .env.
#
# 1. SWID and espn_s2: browser cookies on fantasy.espn.com (see README: "Finding your ESPN Cookies")
# 2. LEAGUE_ID: in the league URL
# 3. YEAR: the season (e.g. 2026)
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2=XXXXXXXXXXXXXXX
ESPN_LEAGUE_ID=XXXXXXX
ESPN_YEAR=2026

# Slack user ID -> ESPN team ID. Used by get_team_owners, so Sofie never guesses who owns what.
# JSON object: {"U1234567890": 1, "U0987654321": 2}
SOFFEE_SLACK_USER_TO_TEAM_MAP={"U1234567890": 1}

# Slack is handled by OpenClaw (its Slack channel plugin), not by this server, so no Slack tokens here.
# Scheduled recaps are OpenClaw cron jobs; their output posts to this channel.
SOFFEE_BROADCAST_CHANNEL=#nfl-updates
